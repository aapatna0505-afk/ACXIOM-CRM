@{
    ViewData["Title"] = "Welcome";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CRM System</title>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />

    <style>
        body {
            height: 100vh;
            margin: 0;
            background: #101010;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            overflow: hidden;
            display: flex;
            justify-content: center;
            align-items: center;
            position: relative;
        }

            /* Background Image */
            body::before {
                content: "";
                position: fixed;
                inset: 0;
                background-image: url('https://img.freepik.com/premium-photo/business-man-handshake-with-effect-global-network-link-connection-graph-chart-stock-market-graphic-diagram_33829-195.jpg?w=740');
                background-size: cover;
                background-position: center;
                background-repeat: no-repeat;
                filter: brightness(0.7) blur(1.5px);
                z-index: -10;
            }

        /* Overlay */
        .bg-overlay {
            position: absolute;
            inset: 0;
            background: rgba(30, 58, 138, 0.55);
            z-index: -5;
        }

        /* Soft glow shapes */
        .shape {
            position: absolute;
            border-radius: 50%;
            filter: blur(70px);
            opacity: 0.12;
            background: white;
            z-index: -4;
        }

        .shape1 {
            width: 350px;
            height: 350px;
            top: 10%;
            left: 7%;
        }

        .shape2 {
            width: 420px;
            height: 420px;
            bottom: 10%;
            right: 7%;
        }

        /* Main Card */
        .main-card {
            width: 550px;
            max-width: 90%;
            padding: 45px;
            background: rgba(255, 255, 255, 0.15);
            border: 1px solid rgba(255, 255, 255, 0.35);
            backdrop-filter: blur(15px);
            border-radius: 25px;
            text-align: center;
            box-shadow: 0 15px 40px rgba(0,0,0,0.25);
        }

        .logo-icon {
            font-size: 60px;
            color: white;
            margin-bottom: 18px;
        }

        h2 {
            font-weight: 800;
            color: white;
            margin-bottom: 10px;
        }

        .subtitle {
            color: #e5e7eb;
            font-size: 1.1rem;
            margin-bottom: 40px;
        }

        /* Professional Gradient Buttons */
        .btn-login {
            background: linear-gradient(135deg, #3b82f6, #1e40af);
            color: white;
            border: none;
            border-radius: 10px;
            transition: 0.3s ease;
        }

            .btn-login:hover {
                background: linear-gradient(135deg, #2563eb, #1e3a8a);
                transform: translateY(-2px);
            }

        .btn-register {
            background: linear-gradient(135deg, #10b981, #065f46);
            color: white;
            border: none;
            border-radius: 10px;
            transition: 0.3s ease;
        }

            .btn-register:hover {
                background: linear-gradient(135deg, #059669, #064e3b);
                transform: translateY(-2px);
            }

    </style>
</head>

<body>
    <div class="bg-overlay"></div>
    <div class="shape shape1"></div>
    <div class="shape shape2"></div>

    <div class="main-card">
        <div class="logo-icon">👨🏽‍💻</div>

        <h2>Welcome to CRM System</h2>
        <p class="subtitle">Your smart platform for modern customer and employee management.</p>

        <div class="d-flex justify-content-center gap-3">
            <a href="/Account/Login" class="btn btn-login px-4 py-2">Login</a>
            <a href="/Account/Register" class="btn btn-register px-4 py-2">Register</a>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>
