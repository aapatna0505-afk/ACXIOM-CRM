@model IEnumerable<CRM.Models.Customer>

@{
    ViewData["Title"] = "Customers";
}

<div class="container mt-5">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bolder text-white">👥 Customer Management</h2>
        <a asp-controller="Customers" asp-action="Create" class="btn btn-success btn-lg shadow-sm">
            <i class="bi bi-plus-circle-fill me-2"></i> Add New Customer
        </a>
    </div>

    <form asp-action="Index" method="get" class="input-group mb-4 shadow-sm rounded-pill border">
        <span class="input-group-text bg-white border-0 ps-4">
            <i class="bi bi-search"></i>
        </span>
        <input type="text"
               name="SearchTerm"
               value="@Context.Request.Query["SearchTerm"]"
               class="form-control border-0 py-2"
               placeholder="Search customers by name, email, or phone..." />
        <button class="btn btn-purple border-0 pe-4" type="submit">
            Filter
        </button>
    </form>

    <div class="card shadow-lg border-0 golden-card">
        <div class="card-header bg-light border-bottom border-gold text-gold fw-semibold">
            Recent Customer Data
        </div>

        <div class="card-body p-0">

            @if (!Model.Any())
            {
                <div class="text-center p-5">
                    <p class="lead text-muted">No customers found.</p>
                    <a asp-controller="Customers" asp-action="Create" class="btn btn-outline-success mt-3">
                        Start by adding your first customer!
                    </a>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0 colorful-table">
                        <thead class="table-gradient text-white">
                            <tr>
                                <th>Name</th>
                                <th>Email</th>
                                <th>Phone</th>
                                <th class="text-center" style="width: 200px;">Actions</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="fw-semibold">@item.name</td>
                                    <td class="text-muted">@item.email</td>
                                    <td>@item.phoneNumber</td>

                                    <td class="text-center">
                                        <a asp-action="Details" asp-route-id="@item.Id"
                                           class="btn btn-sm btn-info text-white me-1">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@item.Id"
                                           class="btn btn-sm btn-warning me-1">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.Id"
                                           class="btn btn-sm btn-danger">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>

                    </table>
                </div>
            }
        </div>
    </div>

    <div class="d-flex justify-content-end mt-3">
        <small class="text-muted">Total Customers: @Model.Count()</small>
    </div>

</div>

<style>
    html, body {
        height: 100%;
        margin: 0;
        padding: 0;
    }

    /* Background Image */
    body {
        background: url('https://wallpapers.com/images/hd/hd-office-background-2560-x-1600-tu0cwqnuk9edlama.jpg') no-repeat center center fixed;
        background-size: cover;
    }

    /* Golden color classes */
    .text-gold {
        color: #b8860b !important;
    }

    .border-gold {
        border-color: #b8860b !important;
    }

    .golden-card {
        background: rgba(255, 255, 255, 0.9) !important;
        border-left: 4px solid #b8860b !important;
        backdrop-filter: blur(6px);
    }

    /* Purple Filter Button */
    .btn-purple {
        background-color: #7a3eea;
        color: white;
        font-weight: 500;
        border-radius: 20px;
        padding: 6px 20px;
        transition: 0.2s ease-in-out;
    }

        .btn-purple:hover {
            background-color: #622bc9;
            color: #fff;
        }

    /* Gradient table header */
    .table-gradient {
        background: linear-gradient(to right, #7a3eea, #b8860b);
    }

    /* Soft pastel alternating row colors */
    .colorful-table tbody tr:nth-child(1n) {
        background-color: #fdf5e6;
    }

    .colorful-table tbody tr:nth-child(2n) {
        background-color: #f3e8ff;
    }

    .colorful-table tbody tr:nth-child(3n) {
        background-color: #e7f6ff;
    }

    /* Hover effect */
    .colorful-table tbody tr:hover {
        background-color: #fff2b3 !important;
        transition: 0.2s ease-in-out;
    }
</style>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            try {
                var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
                tooltipTriggerList.map(function (el) { return new bootstrap.Tooltip(el); });
            } catch (e) { }
        });
    </script>
}
